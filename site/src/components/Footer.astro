---
// * Pie: marca con su frase y botón de GitHub, tres columnas de enlaces (producto, descargas directas y proyecto), los
// * créditos y, al fondo, la palabra "Rebootera" enorme y medio cortada, con la luz del tema.
import L from "./L.astro";
---

<footer class="relative z-10 overflow-hidden border-t border-line bg-bg/70">
  <div class="relative mx-auto max-w-6xl px-5 pb-10 pt-16">
    <div class="grid gap-12 md:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(0,1fr))]">
      <div>
        <div class="flex items-center gap-4">
          <svg width="48" height="48" class="shrink-0" aria-hidden="true"><use href="#rbt-logo"></use></svg>
          <div class="font-display text-2xl tracking-tight">Rebootera <span class="italic text-accent">OS</span></div>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted"><L en="Install and fix any system from one USB. Official images, checked, with your drivers." es="Instala y arregla cualquier sistema desde un solo USB. Imágenes oficiales, comprobadas y con tus drivers." /></p>
        <a class="mt-6 inline-flex h-11 items-center gap-2.5 rounded-xl border border-line2 bg-panel/70 px-4 text-sm font-semibold text-muted transition hover:border-accent/60 hover:text-ink" href="https://github.com/Jondals/Rebootera-OS" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" /></svg>GitHub</a>
      </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-dim"><L en="Product" es="Producto" /></p>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a class="text-muted transition hover:text-accent" href="#features"><L en="Features" es="Funciones" /></a></li>
            <li><a class="text-muted transition hover:text-accent" href="#systems"><L en="Systems" es="Sistemas" /></a></li>
            <li><a class="text-muted transition hover:text-accent" href="#how"><L en="How it works" es="Cómo funciona" /></a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-dim"><L en="Download" es="Descargas" /></p>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a class="text-muted transition hover:text-accent" href="https://github.com/Jondals/Rebootera-OS/releases/latest/download/Rebootera-Desktop-Windows.exe">Windows</a></li>
            <li><a class="text-muted transition hover:text-accent" href="https://github.com/Jondals/Rebootera-OS/releases/latest/download/Rebootera-Desktop-macOS-AppleSilicon">macOS</a></li>
            <li><a class="text-muted transition hover:text-accent" href="https://github.com/Jondals/Rebootera-OS/releases/latest/download/Rebootera-Desktop-Linux-x64">Linux</a></li>
            <li><a class="text-muted transition hover:text-accent" href="https://github.com/Jondals/Rebootera-OS/releases/latest/download/rebootera-os-amd64.iso"><L en="ISO image" es="Imagen ISO" /></a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-dim"><L en="Project" es="Proyecto" /></p>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a class="text-muted transition hover:text-accent" href="https://github.com/Jondals/Rebootera-OS">GitHub</a></li>
            <li><a class="text-muted transition hover:text-accent" href="https://github.com/Jondals/Rebootera-OS/releases"><L en="All versions" es="Todas las versiones" /></a></li>
            <li><a class="text-muted transition hover:text-accent" href="https://github.com/Jondals/Rebootera-OS/releases/latest"><L en="Latest release" es="Última versión" /></a></li>
          </ul>
        </div>
    </div>

    <div class="mt-12 h-px bg-gradient-to-r from-transparent via-line2 to-transparent"></div>

    <div class="mt-6 flex flex-col gap-3 text-xs text-dim md:flex-row md:items-center md:justify-between">
      <p><L en="Built on Debian GNU/Linux. The USB uses Ventoy (GPLv3) to boot several systems." es="Construido sobre Debian GNU/Linux. El USB usa Ventoy (GPLv3) para arrancar varios sistemas." /></p>
      <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
        <L en="Made with" es="Hecha con" />
        <a class="tech inline-flex items-center gap-1.5 font-medium" style="--brand: #ff5d01" href="https://astro.build" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.358 20.162c-1.186-1.07-1.532-3.316-1.038-4.944.856 1.026 2.043 1.352 3.272 1.535 1.897.283 3.76.177 5.522-.678.202-.098.388-.229.608-.36.166.473.209.95.151 1.437-.14 1.185-.738 2.1-1.688 2.794-.38.277-.782.525-1.175.787-1.205.804-1.531 1.747-1.078 3.119l.044.148a3.158 3.158 0 0 1-1.407-1.188 3.31 3.31 0 0 1-.544-1.815c-.004-.32-.004-.642-.048-.958-.106-.769-.472-1.113-1.161-1.133-.707-.02-1.267.411-1.415 1.09-.012.053-.028.104-.045.165h.002zm-5.961-4.445s3.24-1.575 6.49-1.575l2.451-7.565c.092-.366.36-.614.662-.614.302 0 .57.248.662.614l2.45 7.565c3.85 0 6.491 1.575 6.491 1.575L16.088.727C15.93.285 15.663 0 15.303 0H8.697c-.36 0-.615.285-.784.727l-5.516 14.99z" fill="currentColor" /></svg>Astro
        </a>
        <L en="and" es="y" />
        <a class="tech inline-flex items-center gap-1.5 font-medium" style="--brand: #06b6d4" href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.001,4.8c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 C13.666,10.618,15.027,12,18.001,12c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C16.337,6.182,14.976,4.8,12.001,4.8z M6.001,12c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 c1.177,1.194,2.538,2.576,5.512,2.576c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C10.337,13.382,8.976,12,6.001,12z" fill="currentColor" /></svg>Tailwind CSS
        </a>
      </p>
    </div>
  </div>
  <div class="footer-word" aria-hidden="true">Rebootera</div>
</footer>
