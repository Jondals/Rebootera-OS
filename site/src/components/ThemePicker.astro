---
// * Selector de temas: una cuadrícula de muestras planas (un círculo con el fondo del tema y un punto con su acento),
// * con el nombre debajo. site.js marca la activa (aria-checked) y aplica la que se pulse.
import { THEMES } from "../data/themes";
import L from "./L.astro";
---

<div class="theme-grid" role="radiogroup" aria-label="Theme">
  {
    THEMES.map(function option(theme) {
      return (
        <button type="button" role="radio" aria-checked="false" data-theme-opt={theme.id} class="theme-orb" style={"--o-bg: " + theme.bg + "; --o-accent: " + theme.accent + "; --o-strong: " + theme.strong}>
          <span class="orb"></span>
          <span class="truncate">
            <L en={theme.name.en} es={theme.name.es} />
          </span>
        </button>
      );
    })
  }
</div>
