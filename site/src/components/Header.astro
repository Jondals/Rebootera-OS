---
// * Cabecera fija: marca, enlaces a las secciones, botón de temas (un anillo con los colores de todos) y selector de
// * idioma. En el móvil, los enlaces, los temas y el idioma se juntan en un único menú.
import L from "./L.astro";
import Icon from "./Icon.astro";
import ThemePicker from "./ThemePicker.astro";
import LangSwitch from "./LangSwitch.astro";
import { THEMES } from "../data/themes";

const links = [
  { href: "#top", en: "Home", es: "Inicio" },
  { href: "#features", en: "Features", es: "Funciones" },
  { href: "#systems", en: "Systems", es: "Sistemas" },
  { href: "#how", en: "How it works", es: "Cómo funciona" },
  { href: "#faq", en: "Questions", es: "Preguntas" },
];

/** Los acentos de todos los temas, para el anillo del botón. */
const ring = THEMES.map(function accent(theme) {
  return theme.accent;
})
  .concat(THEMES[0].accent)
  .join(", ");
---

<header id="header" data-scrolled="false" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-500 data-[scrolled=true]:border-line data-[scrolled=true]:bg-bg/80">
  <div class="mx-auto flex h-[68px] max-w-6xl items-center justify-between gap-3 px-4 sm:px-5">
    <a href="#top" class="flex items-center gap-3">
      <svg width="34" height="34" class="shrink-0" aria-hidden="true"><use href="#rbt-logo"></use></svg>
      <span class="whitespace-nowrap font-display text-lg font-medium tracking-tight sm:text-xl">Rebootera <span class="italic text-accent">OS</span></span>
    </a>

    <nav class="hidden items-center gap-1 text-sm text-muted md:flex" aria-label="Main">
      {
        links.map(function link(item) {
          return (
            <a class="rounded-lg px-3 py-2 transition hover:bg-panel2 hover:text-ink" href={item.href}>
              <L en={item.en} es={item.es} />
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="relative hidden md:block">
        <button type="button" data-menu-btn="themes" aria-expanded="false" aria-haspopup="true" aria-label="Theme / Tema" class="hdr-btn inline-flex w-10">
          <span class="theme-ring" style={"--ring: " + ring}></span>
        </button>
        <div data-menu="themes" data-open="false" class="menu-panel absolute right-0 top-[calc(100%+10px)] w-[320px] rounded-xl border border-line2 bg-panel p-2 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.9)]">
          <p class="px-2 pb-2 pt-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-dim"><L en="Theme" es="Tema" /></p>
          <ThemePicker />
        </div>
      </div>

      <div class="hidden md:block"><LangSwitch /></div>

      <button type="button" data-menu-btn="mobile" aria-expanded="false" aria-label="Menu" class="hdr-btn inline-flex w-10 md:hidden">
        <span data-icon-open><Icon name="menu" size={20} /></span>
        <span data-icon-close class="hidden"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>

  <div data-menu="mobile" data-open="false" class="menu-panel absolute inset-x-3 top-[76px] max-h-[calc(100dvh-92px)] overflow-y-auto rounded-xl border border-line2 bg-panel p-3 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.9)] md:hidden">
    <nav class="grid gap-0.5 text-[15px]" aria-label="Mobile">
      {
        links.map(function link(item) {
          return (
            <a class="rounded-lg px-3 py-2.5 text-muted transition hover:bg-panel2 hover:text-ink" href={item.href} data-close-menu>
              <L en={item.en} es={item.es} />
            </a>
          );
        })
      }
    </nav>
    <p class="mb-2 mt-4 px-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-dim"><L en="Theme" es="Tema" /></p>
    <ThemePicker />
    <p class="mb-2 mt-4 px-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-dim"><L en="Language" es="Idioma" /></p>
    <div class="px-1 pb-1"><LangSwitch /></div>
  </div>
</header>
