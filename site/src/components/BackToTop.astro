---
// * Botón flotante para volver arriba (a la portada y la descarga). Aparece al bajar un poco; lo conecta site.js.
import Icon from "./Icon.astro";
---

<button type="button" id="to-top" data-show="false" aria-label="Back to top" title="Back to top" class="totop fixed bottom-5 right-5 z-40 grid h-12 w-12 place-items-center rounded-xl border border-line2 bg-panel/80 text-accent shadow-[0_12px_40px_-12px_rgba(0,0,0,0.9)] backdrop-blur-xl hover:-translate-y-0.5 hover:border-accent">
  <Icon name="arrowup" size={20} />
</button>
