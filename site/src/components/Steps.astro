---
// * Cómo funciona: tres pasos numerados unidos por una línea.
import L from "./L.astro";

const steps = [
  { n: "1", title: { en: "Make the USB", es: "Crea el USB" }, text: { en: "Open Rebootera Desktop, press Make USB and choose your drive. If it already has your files on it, they stay.", es: "Abre Rebootera Desktop, pulsa Crear USB y elige tu unidad. Si ya tiene tus archivos, se quedan donde están." } },
  { n: "2", title: { en: "Boot from it", es: "Arranca desde él" }, text: { en: "Restart and open the boot menu (F12, F11, F8, F9 or Esc, depending on the computer). Rebootera opens on its own.", es: "Reinicia y abre el menú de arranque (F12, F11, F8, F9 o Esc, según el equipo). Rebootera se abre solo." } },
  { n: "3", title: { en: "Install what you want", es: "Instala lo que quieras" }, text: { en: "Search for an image or add yours, let Rebootera check your hardware and start the original installer.", es: "Busca una imagen o añade la tuya, deja que Rebootera revise tu equipo y lanza el instalador original." } },
];
---

<section id="how" class="relative z-10 mx-auto max-w-6xl px-5 py-24">
  <div class="reveal mb-14 max-w-3xl">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent"><L en="How it works" es="Cómo funciona" /></p>
    <h2 class="font-display text-4xl tracking-tight md:text-5xl"><L en="From nothing to installed in three steps" es="De cero a instalado en tres pasos" /></h2>
  </div>
  <div class="relative grid gap-6 md:grid-cols-3">
    {
      steps.map(function step(item, index) {
        return (
          <div class="reveal relative rounded-3xl border border-line bg-panel/60 p-7 backdrop-blur" style={"--d: " + index * 120 + "ms"}>
            <div class="relative mb-5 grid h-14 w-14 place-items-center rounded-xl border border-accent/50 bg-bg font-display text-2xl text-accent shadow-[0_0_30px_-6px_rgba(var(--accent-rgb),0.6)]">{item.n}</div>
            <h3 class="font-display text-2xl"><L en={item.title.en} es={item.title.es} /></h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted"><L en={item.text.en} es={item.text.es} /></p>
          </div>
        );
      })
    }
  </div>
</section>
