---
// * Selector de idioma: un globo y el código del idioma activo (EN o ES). Pulsarlo pasa al otro idioma al instante.
// * Lo conecta site.js (data-toggle-lang).
import Icon from "./Icon.astro";
---

<button type="button" data-toggle-lang class="hdr-btn lang-btn inline-flex" aria-label="Language / Idioma">
  <Icon name="globe" size={17} class="globe" />
  <span class="en">EN</span><span class="es">ES</span>
</button>
