---
// * Botón único de idioma: una pastilla con el código del otro idioma (ES en inglés, EN en español) y su nombre. Al
// * pulsarlo, cambia la página con un fundido. Lo conecta site.js.
import L from "./L.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<button type="button" data-toggle-lang class={"lang-btn group inline-flex items-center gap-2.5 rounded-lg border border-line2 py-1.5 pl-1.5 pr-3 text-sm font-semibold text-muted transition hover:border-accent/60 hover:text-ink " + className} aria-label="Language / Idioma">
  <span class="lang-chip"><L en="ES" es="EN" /></span>
  <span><L en="Español" es="English" /></span>
</button>
