#!/bin/bash
# * browser: abre Firefox dentro de la sesión del kiosco, ya configurado: solo navegar, en modo oscuro, sin telemetría,
# * con uBlock Origin y Dark Reader instalados y nada más (las reglas están en
# * /usr/lib/firefox-esr/distribution/policies.json). Usa un perfil en /run (memoria): no deja rastro al apagar.
# * Si ya hay una ventana abierta y no se pide una página, no abre otra.
# ! Lo lanza rebootera-shell cuando la interfaz lo pide. Solo acepta como argumento una dirección https sencilla
# ! (rebootera-shell ya la comprobó; aquí se vuelve a comprobar); cualquier otra cosa abre una página en blanco.
set -u

PROFILE="${XDG_RUNTIME_DIR:-/tmp}/rebootera-firefox"
SAFE='^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~:/?#@!$&()*+,;=%-]*)?$'

# * Con una sesión de Firefox ya en marcha, solo se avisa de que está abierta (labwc la trae al frente al pulsar Alt+Tab).
if pgrep -u "$(id -u)" -f 'firefox-esr.*rebootera-firefox' >/dev/null; then
	# * Con una dirección nueva, rebootera-shell ya cerró la anterior: se espera un instante a que termine.
	[ -n "${1:-}" ] && sleep 1.5 || exit 0
fi

PAGE=about:blank
if [[ "${1:-}" =~ $SAFE ]]; then
	PAGE="$1"
fi

mkdir -p "$PROFILE"
exec /usr/bin/firefox-esr --no-remote --profile "$PROFILE" "$PAGE"
