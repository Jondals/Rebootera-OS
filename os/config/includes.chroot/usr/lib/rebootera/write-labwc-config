#!/bin/bash
# * write-labwc-config: genera la configuración de labwc (solo las reglas de ventana). El puntero y el panel táctil
# * se dejan con los valores por defecto de libinput/labwc: tocar y arrastrar, clic con toque, etc. funcionan como en
# * cualquier Linux. Lo ejecuta start-kiosk al arrancar. Argumento: carpeta de la configuración.
set -u
CONFIG_DIR="${1:?falta la carpeta}"

mkdir -p "$CONFIG_DIR"
cat >"$CONFIG_DIR/rc.xml" <<'XML'
<?xml version="1.0"?>
<labwc_config>
  <core><gap>0</gap></core>
  <windowRules>
    <windowRule identifier="os.rebootera.Shell" serverDecoration="no"/>
  </windowRules>
</labwc_config>
XML
printf '%s\n' '/usr/lib/rebootera/session &' >"$CONFIG_DIR/autostart"
