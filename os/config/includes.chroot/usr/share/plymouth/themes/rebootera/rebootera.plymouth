# * Tema de arranque de Rebootera OS (módulo script de Plymouth). Los
# * gráficos (logo.png, glow.png, wordmark.png, bar-*.png) los genera
# * scripts/build.sh a partir de branding/logo.svg.
[Plymouth Theme]
Name=Rebootera
Description=Rebootera OS boot splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/rebootera
ScriptFile=/usr/share/plymouth/themes/rebootera/rebootera.script
