# * Rebootera Core: servicio sin privilegios que sirve la interfaz y su API en
# 127.0.0.1:7080. Publica el token del arranque en /run/rebootera-core, legible
# solo por el grupo rebootera-ui (la ventana kiosco).
[Unit]
Description=Rebootera Core
Wants=rebootera-agent.service rebootera-vault.service
After=rebootera-agent.service rebootera-vault.service network.target

[Service]
Type=simple
User=rebootera-core
Group=rebootera-ui
SupplementaryGroups=rebootera-core
ExecStart=/usr/lib/rebootera/rebootera-core
RuntimeDirectory=rebootera-core
RuntimeDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=1

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# * Única ruta escribible: /run/rebootera (Vault y medios montados por el agente).
ReadWritePaths=-/run/rebootera
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
