# * Rebootera UI: sesión kiosco en tty1. labwc ejecuta la interfaz a pantalla completa
# * (rebootera-shell) y, si el usuario lo pide, el navegador, como el usuario sin privilegios
# * "rebootera". Si se cierra, systemd la vuelve a abrir.
[Unit]
Description=Rebootera UI (kiosco)
Wants=rebootera-core.service
# * No se espera a plymouth-quit-wait (hasta el final del arranque): ExecStartPre cierra
# * Plymouth justo antes de abrir la ventana, y así la interfaz sale mucho antes.
After=rebootera-core.service systemd-user-sessions.service plymouth-start.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=rebootera
PAMName=rebootera-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XKB_DEFAULT_LAYOUT=es
Environment=GDK_BACKEND=wayland
# Los buffers DMA-BUF fallan en muchas GPU virtuales y algunas reales; el
# renderizado por memoria compartida es más compatible.
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
# Sin aceleración por hardware (máquinas virtuales, GPU sin driver) wlroots se
# niega a usar el renderizado por software salvo que se le permita.
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
# pam_systemd concede CAP_WAKE_ALARM como capacidad ambiental a las sesiones de
# usuario, y bubblewrap (el sandbox de WebKitGTK) se niega a ejecutarse si el
# proceso tiene cualquier capacidad. setpriv la retira antes de lanzar labwc.
# start-kiosk lanza labwc probando varios niveles de renderizado (ver el script).
ExecStart=/usr/bin/setpriv --ambient-caps=-all --inh-caps=-all -- /usr/lib/rebootera/start-kiosk
# * Al parar la sesión (también al reiniciarla) se matan los procesos que hayan quedado fuera del grupo del
# * servicio: un labwc huérfano seguiría agarrando la pantalla y el nuevo no podría dibujar.
ExecStopPost=+/bin/sh -c 'pkill -KILL -u rebootera; exit 0'
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
