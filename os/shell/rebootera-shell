#!/usr/bin/python3
# * rebootera-shell: ventana kiosco de Rebootera OS. Se ejecuta dentro de labwc
# * (compositor Wayland), espera a que rebootera-core esté listo, canjea el token
# * del arranque por la cookie de sesión y muestra la interfaz a pantalla completa.
# * Bloquea cualquier navegación fuera de la interfaz local, desactiva el menú
# * contextual y las herramientas de desarrollo, y recarga la interfaz si su proceso
# * se cierra inesperadamente. La interfaz puede pedirle abrir el navegador con un mensaje {"action": "browser"} (una
# * ventana WebKit ligera en este mismo proceso, sin historial ni cookies guardados) y le avisa de que ya se dibuja con
# * {"action": "ready"}.

import json
import os
import re
import subprocess
import sys
import urllib.parse
import urllib.request

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("WebKit", "6.0")
from gi.repository import GLib, Gtk, WebKit  # noqa: E402

CORE_URL = "http://127.0.0.1:7080"
TOKEN_FILE = "/run/rebootera-core/ui-token"
POLL_MS = 500
BACKGROUND = "#0b0d11"
# * Única forma de dirección que el navegador acepta de la interfaz: https, sin espacios ni comillas.
SAFE_URL = re.compile(r"https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~:/?#@!$&()*+,;=%-]*)?")
# * Archivo que start-kiosk vigila: la interfaz avisa de que ya dibujó su primer fotograma y aquí se marca.
READY_FILE = os.environ.get("REBOOTERA_READY", "")


def core_ready():
    """Indica si rebootera-core responde en /healthz."""
    try:
        with urllib.request.urlopen(CORE_URL + "/healthz", timeout=1) as response:
            return response.status == 200
    except OSError:
        return False


def read_token():
    """Lee el token publicado por rebootera-core, o None si aún no existe."""
    try:
        with open(TOKEN_FILE, encoding="ascii") as handle:
            token = handle.read().strip()
            return token or None
    except OSError:
        return None


def is_local(uri):
    """Indica si una URI pertenece a la interfaz local."""
    return uri == CORE_URL or uri.startswith(CORE_URL + "/")


def to_address(text):
    """Convierte lo escrito en la barra del navegador en una dirección: web tal cual, dominio con https o búsqueda."""
    text = text.strip()
    if re.match(r"https?://\S+$", text):
        return text
    if " " not in text and "." in text and not text.startswith("."):
        return "https://" + text
    return "https://duckduckgo.com/?q=" + urllib.parse.quote_plus(text)


BROWSER_CSS = """
.browser-bar { background: #0b0d11; padding: 6px 8px; }
.browser-bar button { min-width: 38px; min-height: 34px; color: #e8e6e1; background: #171a21; border: 1px solid #262a33; border-radius: 8px; }
.browser-bar button:hover { background: #20242d; }
.browser-bar entry { min-height: 34px; color: #e8e6e1; background: #171a21; border: 1px solid #262a33; border-radius: 8px; padding: 0 10px; }
progressbar trough, progressbar progress { min-height: 3px; }
progressbar progress { background: #c9a45c; }
"""


class BrowserWindow:
    """Navegador ligero: otra ventana WebKit del mismo proceso (arranca al instante). Sin cookies ni historial en disco."""

    def __init__(self, app, url, on_closed):
        """Abre la ventana con barra de direcciones y la lleva a la página pedida."""
        self.on_closed = on_closed
        self.window = Gtk.Window(application=app, title="Rebootera OS")
        self.window.set_decorated(False)
        provider = Gtk.CssProvider()
        provider.load_from_string(BROWSER_CSS)
        Gtk.StyleContext.add_provider_for_display(
            self.window.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        session = WebKit.NetworkSession.new_ephemeral()
        session.connect("download-started", self.on_download)
        self.view = WebKit.WebView(network_session=session)
        settings = self.view.get_settings()
        settings.set_enable_developer_extras(False)
        settings.set_enable_smooth_scrolling(False)
        settings.set_enable_page_cache(False)
        settings.set_javascript_can_open_windows_automatically(False)
        if os.environ.get("REBOOTERA_LITE") == "1":
            settings.set_hardware_acceleration_policy(WebKit.HardwareAccelerationPolicy.NEVER)
        self.view.set_background_color(_rgba(BACKGROUND))
        self.view.set_vexpand(True)
        self.view.connect("decide-policy", self.on_decide_policy)
        self.view.connect("notify::uri", self.on_uri)
        self.view.connect("notify::estimated-load-progress", self.on_progress)

        self.entry = Gtk.Entry()
        self.entry.set_hexpand(True)
        self.entry.set_placeholder_text("Buscar o escribir una dirección")
        self.entry.connect("activate", self.on_enter)
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        bar.add_css_class("browser-bar")
        for label, handler in (("‹", self.on_back), ("›", self.on_forward), ("↻", self.on_reload)):
            button = Gtk.Button(label=label)
            button.connect("clicked", handler)
            bar.append(button)
        bar.append(self.entry)
        close = Gtk.Button(label="✕")
        close.connect("clicked", self.on_close)
        bar.append(close)

        self.progress = Gtk.ProgressBar()
        self.progress.set_visible(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(bar)
        box.append(self.progress)
        box.append(self.view)
        self.window.set_child(box)
        self.window.connect("close-request", self.on_close_request)
        self.window.fullscreen()
        self.window.present()
        self.go(url)

    def go(self, url):
        """Lleva el navegador a una dirección."""
        if url:
            self.view.load_uri(url)
        else:
            self.view.load_uri("about:blank")
            self.entry.grab_focus()

    def on_enter(self, entry):
        """Va a lo escrito en la barra."""
        text = entry.get_text()
        if text.strip():
            self.view.load_uri(to_address(text))
            self.view.grab_focus()

    def on_back(self, button):
        """Página anterior."""
        self.view.go_back()

    def on_forward(self, button):
        """Página siguiente."""
        self.view.go_forward()

    def on_reload(self, button):
        """Recarga la página."""
        self.view.reload()

    def on_close(self, button):
        """Cierra el navegador y vuelve a la interfaz."""
        self.window.close()

    def on_close_request(self, window):
        """Libera el navegador entero (la memoria vuelve a la interfaz)."""
        self.view.terminate_web_process()
        self.on_closed()
        return False

    def on_uri(self, view, param):
        """Muestra la dirección actual en la barra (salvo mientras se escribe)."""
        uri = view.get_uri()
        if uri and uri != "about:blank" and not self.entry.has_focus():
            self.entry.set_text(uri)

    def on_progress(self, view, param):
        """Barra fina de progreso: así se ve al momento que la página está cargando."""
        value = view.get_estimated_load_progress()
        self.progress.set_visible(0 < value < 1)
        self.progress.set_fraction(value)

    def on_decide_policy(self, view, decision, decision_type):
        """Solo web (http y https); las ventanas nuevas se abren en esta misma."""
        if decision_type in (WebKit.PolicyDecisionType.NAVIGATION_ACTION, WebKit.PolicyDecisionType.NEW_WINDOW_ACTION):
            uri = decision.get_navigation_action().get_request().get_uri() or ""
            if not re.match(r"(https?://|about:blank$)", uri):
                decision.ignore()
                return True
            if decision_type == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION:
                decision.ignore()
                view.load_uri(uri)
                return True
        return False

    def on_download(self, session, download):
        """Sin descargas: para eso están las secciones de la interfaz."""
        download.cancel()


class Shell:
    """Ventana kiosco con un único WebView."""

    def __init__(self, app):
        """Crea la ventana, el WebView y su configuración restringida."""
        self.window = Gtk.ApplicationWindow(application=app, title="Rebootera OS")
        self.window.set_decorated(False)

        css = Gtk.CssProvider()
        css.load_from_string("window { background: %s; }" % BACKGROUND)
        Gtk.StyleContext.add_provider_for_display(
            self.window.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.view = WebKit.WebView()
        settings = self.view.get_settings()
        settings.set_enable_developer_extras(False)
        settings.set_javascript_can_open_windows_automatically(False)
        settings.set_enable_back_forward_navigation_gestures(False)
        # * Una interfaz de una sola página no necesita desplazamiento animado ni historial en memoria, y sin GPU real
        # * (modo ligero) es más rápido que WebKit dibuje todo por software de una vez.
        settings.set_enable_smooth_scrolling(False)
        settings.set_enable_page_cache(False)
        if os.environ.get("REBOOTERA_LITE") == "1":
            settings.set_hardware_acceleration_policy(WebKit.HardwareAccelerationPolicy.NEVER)
        self.view.set_background_color(_rgba(BACKGROUND))
        # * Si start-kiosk dice que se dibuja por software, la página lo sabe desde el
        # * principio (window.REBOOTERA_LITE) y entra en modo ligero.
        if os.environ.get("REBOOTERA_LITE") == "1":
            self.view.get_user_content_manager().add_script(
                WebKit.UserScript.new(
                    "window.REBOOTERA_LITE = true;",
                    WebKit.UserContentInjectedFrames.TOP_FRAME,
                    WebKit.UserScriptInjectionTime.START,
                    None,
                    None,
                )
            )
        # * La interfaz se comunica con la sesión mediante un único canal de mensajes con acciones cerradas.
        manager = self.view.get_user_content_manager()
        manager.register_script_message_handler("rebootera", None)
        manager.connect("script-message-received::rebootera", self.on_message)
        self.app = app
        self.browser = None
        self.view.connect("decide-policy", self.on_decide_policy)
        self.view.connect("context-menu", self.on_context_menu)
        self.view.connect("web-process-terminated", self.on_web_process_terminated)
        self.view.connect("load-failed", self.on_load_failed)

        self.window.set_child(self.view)
        self.window.fullscreen()
        self.window.present()
        GLib.timeout_add(POLL_MS, self.try_connect)

    def try_connect(self):
        """Espera a que Core y su token estén listos y abre la interfaz."""
        token = read_token()
        if token is None or not core_ready():
            return GLib.SOURCE_CONTINUE
        self.view.load_uri(CORE_URL + "/auth?token=" + token)
        return GLib.SOURCE_REMOVE

    def on_message(self, manager, value):
        """Atiende los mensajes de la interfaz: las acciones cerradas "ready" y "browser"."""
        try:
            message = json.loads(value.to_string())
        except ValueError:
            return
        if not isinstance(message, dict):
            return
        if message.get("action") == "ready":
            self.mark_ready()
        elif message.get("action") == "browser":
            self.open_browser(message.get("url"))

    def mark_ready(self):
        """Marca que la interfaz ya se dibuja (start-kiosk espera este archivo antes de darla por buena)."""
        if READY_FILE:
            try:
                with open(READY_FILE, "w", encoding="ascii") as handle:
                    handle.write("1")
            except OSError:
                pass

    def open_browser(self, url=None):
        """Abre el navegador, en una página https si la interfaz la pide (si ya hay uno abierto, se lleva a ella)."""
        address = url if isinstance(url, str) and SAFE_URL.fullmatch(url) else None
        if self.browser is not None:
            if address:
                self.browser.go(address)
            self.browser.window.present()
            return
        self.browser = BrowserWindow(self.app, address, self.on_browser_closed)

    def on_browser_closed(self):
        """El navegador se cerró: vuelve a mostrarse la interfaz."""
        self.browser = None
        self.window.present()

    def on_decide_policy(self, view, decision, decision_type):
        """Permite solo la navegación dentro de la interfaz local."""
        if decision_type == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION:
            decision.ignore()
            return True
        if decision_type == WebKit.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if not is_local(uri):
                print("navegación bloqueada: %s" % uri, file=sys.stderr)
                decision.ignore()
                return True
        return False

    def on_context_menu(self, view, menu, hit_test):
        """Suprime el menú contextual del navegador."""
        return True

    def on_web_process_terminated(self, view, reason):
        """Vuelve a abrir la interfaz si el proceso web se cierra."""
        print("el proceso web terminó (%s); reiniciando la interfaz" % reason, file=sys.stderr)
        GLib.timeout_add(POLL_MS, self.try_connect)

    def on_load_failed(self, view, event, uri, error):
        """Reintenta si Core se reinicia mientras se carga la interfaz."""
        print("fallo al cargar %s: %s" % (uri, error.message), file=sys.stderr)
        GLib.timeout_add(POLL_MS * 2, self.try_connect)
        return False


def _rgba(color):
    """Convierte un color CSS en Gdk.RGBA."""
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk

    rgba = Gdk.RGBA()
    rgba.parse(color)
    return rgba


def on_activate(app):
    """Crea la ventana cuando GTK activa la aplicación."""
    app.shell = Shell(app)


def main():
    """Arranca la aplicación GTK."""
    app = Gtk.Application(application_id="os.rebootera.Shell")
    app.connect("activate", on_activate)
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())
